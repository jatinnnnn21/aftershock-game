{
  "name": "aftershock-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/server.ts",
    "dev:client": "vite",
    "dev": "tsx server/server.ts",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "vite build",
    "start": "tsx server/server.ts",
    "test:sim": "tsx tests/simulation-test.ts",
    "test:e2e": "tsx tests/e2e-match-test.ts",
    "test:audit": "tsx tests/comprehensive-audit-test.ts",
    "test:public": "tsx tests/e2e-public-match-test.ts",
    "test": "tsx tests/simulation-test.ts && tsx tests/e2e-match-test.ts && tsx tests/comprehensive-audit-test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
